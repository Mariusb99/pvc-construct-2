# Conexiune PostgreSQL (Supabase: Project Settings -> Database -> Connection string -> URI, mod "Session pooler" pt. Vercel)
DATABASE_URL="postgresql://user:password@host:5432/database"

# Secret pentru sesiuni Auth.js — generează unul random: `openssl rand -base64 32`
AUTH_SECRET="schimba-acest-secret"

# URL public al site-ului (folosit in metadata, sitemap, emailuri)
NEXT_PUBLIC_SITE_URL="https://www.pvcconstruct.ro"
